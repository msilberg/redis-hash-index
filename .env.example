# Copy to .env and adjust. Every value here has a working default in docker-compose.yml.

# ---- fixture ----
SEED_KEYS=2000000          # cache records to create. 10000000 for the full run (~3.3 GB, ~4 min)
SEED_VALUE=1               # PRNG seed. Same value => same fixture => reproducible runs
CACHE_TTL_SECONDS=3600

# ---- demo run ----
BATCH_USERS=1000           # users sent to the webhook per run
POLL_INTERVAL_MS=1000      # test-api poll cadence, also the WebSocket push cadence
BATCH_DELAY_MS=1000        # quiet baseline before the eviction batch starts

# ---- the fill chain: benchmark -> test-api -> mock-billing ----
SEED_MODE=bulk             # bulk | lazy. lazy fills every record through test-api, capped by LAZY_MAX_KEYS
LAZY_CONCURRENCY=16        # concurrent fills in the lazy and lazy-warm phases
LAZY_MAX_KEYS=50000
LAZY_WARM_USERS=1000       # users filled through the chain after the main phase (the eviction batch)
BILLING_TIMEOUT_MS=5000    # test-api's timeout for each call to mock-billing
ORIGIN_LATENCY_MS=0        # mock-billing: awaited delay before every answer (0..60000)
ORIGIN_FAIL_USER=          # mock-billing: this user id always gets a 503; test-api answers 502, caches nothing

# ---- wiring ----
REDIS_URL=redis://redis:6379
TEST_API_URL=http://test-api:3001
MOCK_BILLING_URL=http://mock-billing:3003   # port 3003; test-api and benchmark both call it
WEBHOOK_URL=http://webhook:3002
TENANT=demo
CATEGORY=activeSubscription
